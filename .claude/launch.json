{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bartendro-web-sim",
      "runtimeExecutable": "bartendro-web",
      "runtimeArgs": ["--sim", "15", "--db", "build/demo.db", "--port", "8080", "--host", "127.0.0.1", "--dev"],
      "port": 8080
    },
    {
      "name": "bartendro-showcase",
      "runtimeExecutable": "bartendro-web",
      "runtimeArgs": ["--sim", "15", "--showcase", "--db", "build/showcase.db", "--port", "8080", "--host", "0.0.0.0"],
      "port": 8080
    },
    {
      "name": "old-ui",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "http.server", "8090", "--bind", "127.0.0.1", "-d", "build/old-ui"],
      "port": 8090
    }
  ]
}
